{% load static %}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Janicka Chata{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />
    
    <link rel="stylesheet" href="{% static 'booking_system/styles.css' %}">
    <link href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,100..900;1,100..900&family=Licorice&family=Markazi+Text:wght@400..700&family=New+Amsterdam&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/75d94097d5.js" crossorigin="anonymous"></script>
    <style>

        .frosted-glass {
            backdrop-filter: blur(8px); /* Adjust blur value as needed */
            -webkit-backdrop-filter: blur(8px); /* Safari support */
        }
            html, body {
                margin: 0;
                padding-top: 0px;
                height: 100%;
              }
              
              /* Navbar – fixed u góry z przezroczystym tłem */
              .custom-navbar {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1000; /* Zapewnia, że navbar jest nad innymi elementami */
                background-color: transparent;
                transition: all 0.3s ease-in-out;
            }
            
            .navbar-logo {
              padding: 7px 7px;
                width: 140px;
                transition: width 0.3s ease-in-out;
            }
              
              /* Karuzela – pełnoekranowa, zaczynająca się od samego brzegu okna */
              .custom-carousel {
                margin: 0;
                padding: 0;
                height: 100vh;
              }
              
              /* Ustawienie karuzeli, aby każdy slajd zajmował pełną wysokość */
              .custom-carousel .carousel-item {
                height: 100vh;
                position: relative;
              }
              
              /* Obrazy karuzeli – wypełniają cały kontener, z efektem przyciemnienia */
              .custom-carousel .carousel-item img {
                object-fit: cover;
                width: 100%;
                height: 100%;
                filter: brightness(65%);
              }
              
              /* Gradientowy overlay dla lepszej czytelności tekstu */
              .custom-carousel .carousel-item::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.093), rgba(0, 0, 0, 0.537));
                z-index: 1;
              }
              
              /* Captiony karuzeli – wyświetlane nad overlay */
              .custom-carousel .carousel-caption {
                z-index: 2;
              }
              
               
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" href="{% url 'index' %}">
                    <img src="/media/Logo1.png" class="navbar-logo" alt="Logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                        aria-controls="navbarNav" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-flex align-items-center" id="navbarNav">
                    <ul class="navbar nav-underline justify-content-end w-100" style="list-style-type: none;">
                        <li class="nav-item">
                            <a class="nav-link {% if request.resolver_match.url_name == 'index' %}active{% endif %}" href="{% url 'index' %}">O nas</a>
                        </li>
                        <li class="nav-item">
                            {# Zastąp '#' rzeczywistym URL-em dla "Oferty" i 'offer_page_name' nazwą URL-a z urls.py #}
                            <a class="nav-link {% if request.resolver_match.url_name == 'offer_page_name' %}active{% endif %}" href="{% url 'accommodation_facilities:offer' %}">Oferta</a>
                        </li>
                        <li class="nav-item">
                            {# Zastąp '#' rzeczywistym URL-em dla "Galerii zdjęć" i 'gallery_page_name' nazwą URL-a z urls.py #}
                            <a class="nav-link {% if request.resolver_match.url_name == 'gallery_page_name' %}active{% endif %}" href="#">Galeria zdjęć</a>
                        </li>
                        <li class="nav-item">
                            {# Zastąp '#' rzeczywistym URL-em dla "Kontaktu" i 'contact_page_name' nazwą URL-a z urls.py #}
                            <a class="nav-link {% if request.resolver_match.url_name == 'contact_page_name' %}active{% endif %}" href="#">Kontakt</a>
                        </li>
                        {% if user.is_authenticated %}
                        <li class="nav-item">
                            <a href="{% url 'dashboard' %}" class="inline-flex items-center bg-white/80 dark:bg-gray-500/30 frosted-glass hover:bg-[#C68335] text-white font-bold py-2 px-4 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
                                <i class="fas fa-user mr-2"></i>{{user.username }}
                            </a>
                        </li>
                        {% else %}
                        <li class="nav-item">
                            <a href="{% url 'login' %}" class="inline-flex items-center bg-white/80 dark:bg-gray-500/30 frosted-glass hover:bg-[#C68335] text-white font-bold py-2 px-4 rounded-lg shadow-sm transition duration-300 ease-in-out transform hover:scale-105">
                                <i class="fas fa-sign-in-alt mr-2"></i> Zaloguj się
                            </a>
                        </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>
        
          <div id="carouselExampleAutoplaying" class="carousel slide carousel-fade custom-carousel" data-bs-ride="carousel">
            <div class="carousel-indicators">
              <button type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide-to="0" class="active"
                      aria-current="true" aria-label="Slide 1"></button>
              <button type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide-to="1"
                      aria-label="Slide 2"></button>
              <button type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide-to="2"
                      aria-label="Slide 3"></button>     
            </div>
            <div id="carouselExampleAutoplaying" class="carousel slide" data-bs-ride="carousel">
        
              <div class="carousel-inner">
                <div class="carousel-item active" data-bs-interval="3500">
                  <img src="./1.jpeg" class="d-block w-100" alt="Slide 1">
                  <div class="carousel-caption">
                    <p><a class="btn btn-outline" href="#cytat"><i class="fa-solid fa-arrow-down fa-beat arrow"></i></a></p>
                  </div>
                </div>
                <div class="carousel-item" data-bs-interval="2000">
                  <img src="./2.jpeg" class="d-block w-100" alt="Slide 2">
                  <div class="carousel-caption">
                    <p><a class="btn btn-outline" href="#cytat"><i class="fa-solid fa-arrow-down fa-beat arrow"></i></a></p>
                  </div>
                </div>
                <div class="carousel-item" data-bs-interval="2000">
                  <img src="./3.jpg" class="d-block w-100" alt="Slide 3">
                  <div class="carousel-caption">
                    <p><a class="btn btn-outline" href="#cytat"><i class="fa-solid fa-arrow-down fa-beat arrow"></i></a></p>
                  </div>
                </div>
              </div>
              
              <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
              </button>
              <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
              </button>
            
            </div>

    <main>
        {% block content %}
