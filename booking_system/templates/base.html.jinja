{% load static %}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Janicka Chata{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="{% static 'booking_system/styles.css' %}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
        crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,100..900;1,100..900&family=Licorice&family=Markazi+Text:wght@400..700&family=New+Amsterdam&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/75d94097d5.js" crossorigin="anonymous"></script>
    <style>
        .frosted-glass {
            backdrop-filter: blur(8px); /* Adjust blur value as needed */
            -webkit-backdrop-filter: blur(8px); /* Safari support */
        }
            html, body {
                margin: 0;
                padding-top: 0px;
                height: 100%;
              }
              
              /* Navbar – fixed u góry z przezroczystym tłem */
              .custom-navbar {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                z-index: 1000; /* Zapewnia, że navbar jest nad innymi elementami */
                background-color: transparent;
                transition: all 0.3s ease-in-out;
            }
            
            .navbar-logo {
              padding: 7px 7px;
                width: 140px;
                transition: width 0.3s ease-in-out;
            }
              
              /* Karuzela – pełnoekranowa, zaczynająca się od samego brzegu okna */
              .custom-carousel {
                margin: 0;
                padding: 0;
                height: 100vh;
              }
              
              /* Ustawienie karuzeli, aby każdy slajd zajmował pełną wysokość */
              .custom-carousel .carousel-item {
                height: 100vh;
                position: relative;
              }
              
              /* Obrazy karuzeli – wypełniają cały kontener, z efektem przyciemnienia */
              .custom-carousel .carousel-item img {
                object-fit: cover;
                width: 100%;
                height: 100%;
                filter: brightness(65%);
              }
              
              /* Gradientowy overlay dla lepszej czytelności tekstu */
              .custom-carousel .carousel-item::after {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: linear-gradient(to bottom, rgba(0, 0, 0, 0.093), rgba(0, 0, 0, 0.537));
                z-index: 1;
              }
              
              /* Captiony karuzeli – wyświetlane nad overlay */
              .custom-carousel .carousel-caption {
                z-index: 2;
              }

              .toast-rich-offer {
                background-color: #fff;
                border-radius: 0.5rem; /* rounded-lg */
                box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); /* shadow-lg */
                border: none;
                border-left: 5px solid #c68335;
                width: 390px;
                opacity: 0;
                visibility: hidden;
                transform: translateX(25px);
                transition: opacity 0.4s ease-in-out, transform 0.4s ease-in-out, visibility 0.4s;
            }
            
            .toast-rich-offer.show {
                opacity: 1;
                visibility: visible;
                transform: translateX(0);
            }
            
            /* Nagłówek */
            .toast-rich-offer .toast-header {
                background-color: transparent;
                border-bottom: 1px solid #f0f0f0;
                padding: 0.5rem 1rem;
            }
            
            .toast-rich-offer .toast-header .fw-bold {
                color: #c68335;
                font-size: 0.9rem;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }
            
            /* Główna treść powiadomienia */
            .toast-rich-offer .toast-body {
                padding: 1rem;
                display: flex;
                align-items: flex-start;
                gap: 1rem;
            }
            
            /* Kontener na zdjęcie */
            .toast-rich-image-wrapper {
                flex-shrink: 0;
                width: 80px;
                height: 80px;
                border-radius: 0.375rem; /* rounded-md */
                overflow: hidden;
            }
            
            .toast-rich-image-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
            
            /* Kontener na tekst i szczegóły */
            .toast-rich-content-wrapper {
                flex-grow: 1;
            }
            
            .toast-rich-content-wrapper .offer-title {
                font-weight: 600;
                font-size: 1.1rem;
                margin-bottom: 0.5rem;
                color: #111;
            }
            
            .toast-rich-content-wrapper .offer-price {
                font-weight: 700;
                color: #c68335;
                font-size: 1.2rem;
                margin-bottom: 0.75rem;
            }
            
            /* Lista szczegółów oferty */
            .offer-details-list {
                list-style: none;
                padding-left: 0;
                margin-bottom: 1rem;
                font-size: 0.85rem;
                color: #4b5563;
            }
            
            .offer-details-list li {
                display: flex;
                align-items: center;
                margin-bottom: 0.4rem;
            }
            
            .offer-details-list .bi {
                color: #c68335;
                margin-right: 0.5rem;
                font-size: 1rem;
            }
            
            /* Przycisk akcji */
            .btn-offer-details {
                background-color: #c68335;
                border-color: #c68335;
                color: #fff;
                font-weight: 600;
                padding: 0.4rem 0.8rem;
                font-size: 0.9rem;
                width: 100%;
                transition: background-color 0.2s ease, border-color 0.2s ease;
            }
            
            .btn-offer-details:hover {
                background-color: #a96d26;
                border-color: #a96d26;
                color: #fff;
            }
            
            /* Pasek postępu */
            .toast-progress-bar {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 4px;
                background-color: rgba(198, 131, 53, 0.2);
            }
            
            .toast-progress-bar-inner {
                width: 100%;
                height: 100%;
                background-color: #c68335;
                animation: shrink 8s linear forwards;
                animation-play-state: running;
            }
            .toast-rich-offer:not(.show) {
              display: block;
            }
            
            @keyframes shrink {
                from { width: 100%; }
                to { width: 0%; }
            }

    </style>
</head>
