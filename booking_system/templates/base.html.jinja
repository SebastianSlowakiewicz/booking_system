<body>
    <header>
        <nav id="main-navbar" class="bg-white/0 dark:bg-gray-900/0 fixed w-full z-20 top-0 start-0 dark:border-gray-0 p-4 transition-all duration-300 ease-in-out">
            <div class="max-w-screen-xl flex items-center justify-between mx-auto p-4">
