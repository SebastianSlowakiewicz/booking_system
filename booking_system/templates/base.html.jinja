              <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-7.5 3.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707z"/>
            </svg>
        </button>        
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              const scrollToTopBtn = document.getElementById("scrollToTopBtn");
          
              window.addEventListener("scroll", function () {
                  if (window.scrollY > 300) {
                      scrollToTopBtn.style.opacity = "1";
                      scrollToTopBtn.style.visibility = "visible";
                  } else {
                      scrollToTopBtn.style.opacity = "0";
                      scrollToTopBtn.style.visibility = "hidden";
                  }
              });
          
              scrollToTopBtn.addEventListener("click", function () {
                  window.scrollTo({ top: 0, behavior: "smooth" });
              });
          });          
          </script>
          <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
          <script>
            // W Twoim pliku JavaScript, np. static/js/main.js

document.addEventListener('DOMContentLoaded', function() {
  const offerSlider = document.getElementById('offerSlider');
  const prevArrow = document.getElementById('prevArrow');
  const nextArrow = document.getElementById('nextArrow');

  if (offerSlider && prevArrow && nextArrow) {
      // Określamy, ile pikseli ma przewinąć slider
      // Możesz dostosować tę wartość. Dobrą praktyką jest dynamiczne pobieranie szerokości karty.
      let scrollAmount = 320; // Przykładowa wartość, szersza niż pojedyncza karta + margines

      // Funkcja do dynamicznego obliczania szerokości przewijania
      const calculateScrollAmount = () => {
          const firstItem = offerSlider.querySelector('.offer-item');
          if (firstItem) {
              const itemWidth = firstItem.offsetWidth; // Szerokość karty wraz z paddingiem i borderem
              const itemMarginRight = parseInt(window.getComputedStyle(firstItem).marginRight);
              scrollAmount = itemWidth + itemMarginRight * 2; // Szerokość karty + marginesy z obu stron
          }
      };

      // Wywołaj obliczenie przy ładowaniu strony i zmianie rozmiaru okna
      calculateScrollAmount();
      window.addEventListener('resize', calculateScrollAmount);

      prevArrow.addEventListener('click', function() {
          offerSlider.scrollBy({
              left: -scrollAmount,
              behavior: 'smooth'
          });
      });

      nextArrow.addEventListener('click', function() {
          offerSlider.scrollBy({
              left: scrollAmount,
              behavior: 'smooth'
          });
      });

      offerSlider.addEventListener('scroll', checkScrollArrows);

      // Sprawdź początkowy stan strzałek po załadowaniu DOM
      checkScrollArrows();
  }
});
          </script>
  {% if request.resolver_match.url_name == 'index' or request.resolver_match.url_name == 'offer' %}
  {% if special_offers %}
  <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    {% for offer in special_offers %}
      <div class="toast toast-rich-offer" role="alert" aria-live="assertive" aria-atomic="true" id="specialOfferToast{{ forloop.counter }}">
        <div class="toast-header">
          <strong class="me-auto fw-bold"><i class="bi bi-stars me-2"></i>Oferta Specjalna</strong>
          <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
          <div class="toast-rich-image-wrapper">
              {% if offer.photo and offer.photo.url %}
                  <img src="{{ offer.photo.url }}" alt="Zdjęcie oferty: {{ offer.season_name }}">
              {% else %}
                  <img src="https://placehold.co/120x120/c68335/FFFFFF?text={{ offer.season_name|slice:':1'|upper }}" alt="Brak zdjęcia dla: {{ offer.season_name }}">
              {% endif %}
          </div>
          <div class="toast-rich-content-wrapper">
              <h6 class="offer-title">{{ offer.season_name }}</h6>
              <div class="offer-price">{{ offer.price_per_night }} zł <small class="text-muted fw-normal">/ doba</small></div>
          </div>
        </div>
        <div class="toast-footer p-3 pt-0">
           <ul class="offer-details-list">
              <li><i class="bi bi-calendar-check"></i> <div><strong>Termin:</strong> {{ offer.start_date|date:"d.m" }} - {{ offer.end_date|date:"d.m.Y" }}</div></li>
              {% if offer.included_services.all %}
                  <li>
                      <i class="bi bi-patch-check"></i>
                      <div>
                          <strong>W cenie:</strong>
                          {{ offer.included_services.all|join:", " }}
                      </div>
                  </li>
              {% endif %}
          </ul>
          <a href="{% url 'accommodation_facilities:offer' %}" class="btn btn-offer-details">
              Zobacz szczegóły i rezerwuj
          </a>
        </div>
        <div class="toast-progress-bar">
          <div class="toast-progress-bar-inner"></div>
        </div>
      </div>
    {% endfor %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const specialOfferToasts = document.querySelectorAll('.toast-rich-offer');
      
      specialOfferToasts.forEach((toastEl, index) => {
        const toast = new bootstrap.Toast(toastEl, {
          autohide: true,
          delay: 8000 // 8 sekund
        });

        const progressBar = toastEl.querySelector('.toast-progress-bar-inner');

        toastEl.addEventListener('mouseover', () => {
          if (progressBar) progressBar.style.animationPlayState = 'paused';
        });

        toastEl.addEventListener('mouseout', () => {
          if (progressBar) progressBar.style.animationPlayState = 'running';
        });
        
        toastEl.addEventListener('hidden.bs.toast', () => {
          if (progressBar) progressBar.style.animation = 'none';
        });

        setTimeout(() => {
          if (progressBar) progressBar.style.animation = 'shrink 8s linear forwards';
          toast.show();
        }, 1000 * (index + 1));
      });
    });
  </script>
  {% endif %}
  {% endif %}
        </body>
</html>