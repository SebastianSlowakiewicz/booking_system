<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Booking System{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <header>
        <h1><a href="/">Booking System</a></h1>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <div class="navbar-nav">
                    <a class="nav-link" href="{% url 'index' %}">Strona główna</a>
                    <a class="nav-link" href="">Udogodnienia</a>
                </div>
                <div class="navbar-nav">
                    {% if user.is_authenticated %}
                    <a class="nav-link" href="{% url 'dashboard' %}">{{ user.username }}</a>
                    <a class="btn btn-outline-success" href="{% url 'logout' %}">Wyloguj</a>
                    {% else %}
                    <a class="nav-link" href="{% url 'login' %}">Zaloguj</a>
                    <a class="nav-link" href="{% url 'register' %}">Zarejestruj</a>
                    {% endif %}
                </div>
            </div>
        </nav>
    </header>

    <main>
        {% block content %}
        <!-- Treść strony -->
        {% endblock %}
    </main>

    <footer>
        <p>&copy; {{ current_year }} Booking System. Wszelkie prawa zastrzeżone.</p>
    </footer>
</body>
</html>