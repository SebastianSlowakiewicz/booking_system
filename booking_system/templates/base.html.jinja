    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
          integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
          crossorigin="anonymous"></script>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              window.addEventListener("scroll", function () {
                  let navbar = document.querySelector(".custom-navbar");
                  let logo = document.querySelector(".navbar-logo");
          
                  if (window.scrollY > 50) {
                      navbar.style.backgroundColor = "rgba(0, 0, 0, 0.8)"; // Przyciemnienie
                      navbar.style.padding = "5px 5px"; // Zmniejszenie
                      logo.style.width = "90px"; // Logo mniejsze
                  } else {
                      navbar.style.backgroundColor = "transparent"; // Powrót do domyślnego
                      navbar.style.padding = "7px 7px"; // Oryginalny padding
                      logo.style.width = "140px"; // Oryginalne logo
                  }
              });
          });          
          </script>
          <button id="scrollToTopBtn" aria-label="Powrót na górę">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-arrow-up-circle" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-7.5 3.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707z"/>
            </svg>
        </button>        
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              const scrollToTopBtn = document.getElementById("scrollToTopBtn");
          
              window.addEventListener("scroll", function () {
                  if (window.scrollY > 300) {
                      scrollToTopBtn.style.opacity = "1";
                      scrollToTopBtn.style.visibility = "visible";
                  } else {
                      scrollToTopBtn.style.opacity = "0";
                      scrollToTopBtn.style.visibility = "hidden";
                  }
              });
          
              scrollToTopBtn.addEventListener("click", function () {
                  window.scrollTo({ top: 0, behavior: "smooth" });
              });
          });          
          </script>
          <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
          <script>
            // W Twoim pliku JavaScript, np. static/js/main.js

document.addEventListener('DOMContentLoaded', function() {
  const offerSlider = document.getElementById('offerSlider');
  const prevArrow = document.getElementById('prevArrow');
  const nextArrow = document.getElementById('nextArrow');

  if (offerSlider && prevArrow && nextArrow) {
      // Określamy, ile pikseli ma przewinąć slider
      // Możesz dostosować tę wartość. Dobrą praktyką jest dynamiczne pobieranie szerokości karty.
      let scrollAmount = 320; // Przykładowa wartość, szersza niż pojedyncza karta + margines

      // Funkcja do dynamicznego obliczania szerokości przewijania
      const calculateScrollAmount = () => {
          const firstItem = offerSlider.querySelector('.offer-item');
          if (firstItem) {
              const itemWidth = firstItem.offsetWidth; // Szerokość karty wraz z paddingiem i borderem
              const itemMarginRight = parseInt(window.getComputedStyle(firstItem).marginRight);
              scrollAmount = itemWidth + itemMarginRight * 2; // Szerokość karty + marginesy z obu stron
          }
      };

      // Wywołaj obliczenie przy ładowaniu strony i zmianie rozmiaru okna
      calculateScrollAmount();
      window.addEventListener('resize', calculateScrollAmount);

      prevArrow.addEventListener('click', function() {
          offerSlider.scrollBy({
              left: -scrollAmount,
              behavior: 'smooth'
          });
      });

      nextArrow.addEventListener('click', function() {
          offerSlider.scrollBy({
              left: scrollAmount,
              behavior: 'smooth'
          });
      });

      offerSlider.addEventListener('scroll', checkScrollArrows);

      // Sprawdź początkowy stan strzałek po załadowaniu DOM
      checkScrollArrows();
  }
});
          </script>
        </body>
</html>