          <script>
            document.addEventListener("DOMContentLoaded", function () {
              window.addEventListener("scroll", function () {
                  let navbar = document.querySelector(".custom-navbar");
                  let logo = document.querySelector(".navbar-logo");
          
                  if (window.scrollY > 50) {
                      navbar.style.backgroundColor = "rgba(0, 0, 0, 0.8)"; // Przyciemnienie
                      navbar.style.padding = "5px 5px"; // Zmniejszenie
                      logo.style.width = "90px"; // Logo mniejsze
                  } else {
                      navbar.style.backgroundColor = "transparent"; // Powrót do domyślnego
                      navbar.style.padding = "7px 7px"; // Oryginalny padding
                      logo.style.width = "140px"; // Oryginalne logo
                  }
              });
          });          
          </script>
          <button id="scrollToTopBtn" aria-label="Powrót na górę">
