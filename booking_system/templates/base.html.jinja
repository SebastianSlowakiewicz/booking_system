{% load static %}
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Janicka Chata{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    <link rel="stylesheet" href="{% static 'css/styles.css' %}">
    <link href="https://fonts.googleapis.com/css2?family=Aleo:ital,wght@0,100..900;1,100..900&family=Licorice&family=Markazi+Text:wght@400..700&family=New+Amsterdam&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/75d94097d5.js" crossorigin="anonymous"></script>
    <style>
        /* Custom font import for 'Aleo' if it's not a standard Tailwind font */
        /* If 'font-aleo' is a custom font, you'll need to import it like this: */
        /* @import url('https://fonts.googleapis.com/css2?family=Aleo:wght@400;700&display=swap'); */
        body {
            font-family: 'Aleo', sans-serif; /* Using Inter as a neutral default, feel free to change */
        }

        /* Custom style for the frosted glass effect */
        .frosted-glass {
            backdrop-filter: blur(8px); /* Adjust blur value as needed */
            -webkit-backdrop-filter: blur(8px); /* Safari support */
        }
    </style>
</head>
<body>
    <header>
       
        <h1 class="text-center font-aleo text-3xl font-bold mb-4 pt-20">
            <a href="/" class="mr-2 last-of-type:mr-6 text-gray-800 hover:text-gray-600 transition duration-300">
                Janicka Chata
            </a>
        </h1>
        <nav class="bg-white/80 dark:bg-gray-900/30 frosted-glass fixed w-full z-20 top-0 start-0 dark:border-gray-600 shadow-md">
            <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
                <!-- Logo/Brand Section -->
                <a href="{% url 'index' %}" class="flex items-center space-x-3 rtl:space-x-reverse">
                    <!-- Placeholder for logo image -->
                    <img src="https://placehold.co/40x40/E5E7EB/4B5563?text=Logo" class="h-8 rounded-full" alt="Logo Janickiej Chaty">
                    <span class="self-center text-xl font-semibold whitespace-nowrap text-gray-800 dark:text-white">Janicka Chata</span>
                </a>

                <div class="flex md:order-2 space-x-3 md:space-x-0 rtl:space-x-reverse items-center">
                    {% if user.is_authenticated %}
                    <a href="{% url 'dashboard' %}" class="inline-flex items-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="fas fa-user mr-2"></i>{{user.username }}
                    </a>
                    <a href="{% url 'logout' %}" class="block py-2 px-3 text-gray-700 dark:text-gray-200 hover:text-blue-600 dark:hover:text-blue-400 rounded-md md:bg-transparent md:p-0 transition duration-300 ml-2">
                        Wyloguj się
                    </a>
                    {% else %}
                    <a href="{% url 'login' %}" class="inline-flex items-center bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="fas fa-sign-in-alt mr-2"></i> Zaloguj się
                    </a>
                    {% endif %}

                    <!-- Mobile menu button -->
                    <button data-collapse-toggle="navbar-sticky" type="button" class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-500 rounded-lg md:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600" aria-controls="navbar-sticky" aria-expanded="false">
                        <span class="sr-only">Open main menu</span>
                        <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 17 14">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 1h15M1 7h15M1 13h15"/>
                        </svg>
                    </button>
                </div>

                <!-- Navigation Links (Collapsible on mobile) -->
                <div class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1" id="navbar-sticky">
                    <ul class="flex flex-col p-4 md:p-0 mt-4 font-medium border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0 md:bg-transparent dark:bg-gray-800 md:dark:bg-transparent dark:border-gray-700">
                        <li>
                            <a href="{% url 'index' %}" class="block py-2 px-3 text-gray-900 dark:text-white rounded-md hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 dark:hover:text-blue-400 md:p-0 transition duration-300" aria-current="page">O nas</a>
                        </li>
                        {% if user.is_authenticated %}
                        <li>
                            <a href="{% url 'accommodation_facilities:create_booking' %}" class="block py-2 px-3 text-gray-900 dark:text-white rounded-md hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 dark:hover:text-blue-400 md:p-0 transition duration-300">Oferta</a>
                        </li>
                        {% endif %}
                        <li>
                            <a href="#" class="block py-2 px-3 text-gray-900 dark:text-white rounded-md hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 dark:hover:text-blue-400 md:p-0 transition duration-300">Galeria zdjęć</a>
                        </li>
                        <li>
                            <a href="#" class="block py-2 px-3 text-gray-900 dark:text-white rounded-md hover:bg-gray-100 md:hover:bg-transparent md:hover:text-blue-600 dark:hover:text-blue-400 md:p-0 transition duration-300">Kontakt</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main>
        {% block content %}
        <!-- Treść strony -->
        {% endblock %}
        {% block sidebar %}
        {% endblock %}
    </main>

    <footer>
        <p>&copy; {{ current_year }} Booking System. Wszelkie prawa zastrzeżone.</p>
    </footer>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const button = document.querySelector('[data-collapse-toggle="navbar-sticky"]');
            const menu = document.getElementById('navbar-sticky');

            button.addEventListener('click', function() {
                menu.classList.toggle('hidden');
                menu.classList.toggle('block');
                const expanded = this.getAttribute('aria-expanded') === 'true' || false;
                this.setAttribute('aria-expanded', !expanded);
            });
        });
    </script>
</body>
</html>