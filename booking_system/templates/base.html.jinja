    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navbar = document.getElementById("main-navbar");
            const logo = document.getElementById("navbar-logo");
            const navLinks = document.querySelectorAll("#navbar-sticky ul li a");
    
            // Funkcja do oznaczania aktywnego linku
            function highlightActiveLink() {
                const currentPath = window.location.pathname;
    
                navLinks.forEach(link => {
                    link.classList.remove("underline", "text-[#C68335]", "dark:text-[#C68335]");
    
                    const linkHref = link.getAttribute('href');
                    if (linkHref === currentPath ||
                        (linkHref === '{% url "index" %}' && currentPath === '/') || 
                        (linkHref === '/' && currentPath === '{% url "index" %}')
                    ) {
                        link.classList.add("underline", "underline-offset-4", "text-[#C68335]", "dark:text-[#C68335]");
                    }
                });
            }
    
            // Wywołaj funkcję przy ładowaniu strony
            highlightActiveLink();
    
            // Obsługa zmiany navbaru przy przewijaniu
            window.addEventListener("scroll", function () {
                if (window.scrollY > 50) {
                    navbar.classList.add("frosted-glass");
                    navbar.classList.remove("bg-white/0");
                    navbar.classList.add("bg-white/80");
                    navbar.classList.remove("dark:bg-gray-900/0");
                    navbar.classList.add("dark:bg-gray-900/30");
    
                    navbar.classList.remove("p-4");
                    navbar.classList.add("py-1");
    
                    logo.classList.remove("h-28"); // Zmniejszenie logo
                    logo.classList.add("h-20");
                } else {
                    navbar.classList.remove("frosted-glass");
                    navbar.classList.remove("bg-white/80");
                    navbar.classList.add("bg-white/0");
                    navbar.classList.remove("dark:bg-gray-900/30");
                    navbar.classList.add("dark:bg-gray-900/0");
    
                    navbar.classList.remove("py-1");
                    navbar.classList.add("p-4");
    
                    logo.classList.remove("h-8");
                    logo.classList.add("h-28"); // Powrót oryginalnego rozmiaru logo
                }
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navbar = document.getElementById("main-navbar");
            const logo = document.getElementById("navbar-logo");
    
            window.addEventListener("scroll", function () {
                if (window.scrollY > 50) {
                    // Dodaje efekt frosted-glass
                    navbar.classList.add("frosted-glass");
                    // Zmienia tło z przezroczystego na półprzezroczyste (przymrożone)
                    navbar.classList.remove("bg-white/0");
                    navbar.classList.add("bg-white/80"); // Dla jasnego motywu
                    navbar.classList.remove("dark:bg-gray-900/0");
                    navbar.classList.add("dark:bg-gray-900/30"); // Dla ciemnego motywu
    
                    // Zmniejszenie paddingu navbaru
                    navbar.classList.remove("p-4"); // Usuwa p-4 (domyślny padding 1rem = 16px)
                    navbar.classList.add("py-1");   // Dodaje py-1 (padding pionowy 0.25rem = 4px)
    
                    // Zmniejszenie rozmiaru logo
                    logo.classList.remove("h-8"); // Usuwa h-8 (wysokość 2rem = 32px)
                    logo.classList.add("h-6");    // Dodaje h-6 (wysokość 1.5rem = 24px)
                } else {
                    // Powrót do początkowych stylów (przezroczysty navbar bez frosted-glass)
                    navbar.classList.remove("frosted-glass");
                    navbar.classList.remove("bg-white/80");
                    navbar.classList.add("bg-white/0");
                    navbar.classList.remove("dark:bg-gray-900/30");
                    navbar.classList.add("dark:bg-gray-900/0");
    
                    // Powrót paddingu
                    navbar.classList.remove("py-1");
                    navbar.classList.add("p-4");
    
                    // Powrót rozmiaru logo
                    logo.classList.remove("h-6");
                    logo.classList.add("h-8");
                }
            });
        });
    </script>
    <button id="scrollToTopBtn" aria-label="Powrót na górę">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-arrow-up-circle" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M1 8a7 7 0 1 0 14 0A7 7 0 0 0 1 8m15 0A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-7.5 3.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707z"/>
        </svg>
    </button>        
      <script>
        document.addEventListener("DOMContentLoaded", function () {
          const scrollToTopBtn = document.getElementById("scrollToTopBtn");
      
          window.addEventListener("scroll", function () {
              if (window.scrollY > 300) {
                  scrollToTopBtn.style.opacity = "1";
                  scrollToTopBtn.style.visibility = "visible";
              } else {
                  scrollToTopBtn.style.opacity = "0";
                  scrollToTopBtn.style.visibility = "hidden";
              }
          });
      
          scrollToTopBtn.addEventListener("click", function () {
              window.scrollTo({ top: 0, behavior: "smooth" });
          });
      });          
      </script>
</body>
</html>