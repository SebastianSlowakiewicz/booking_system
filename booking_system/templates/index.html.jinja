{% extends "base.html.jinja" %}

{% block title %}
Strona Główna - Booking System
{% endblock %}

{% block content %}

<h2 class="text-2xl font-bold text-gray-800 mb-4">Szybkie akcje</h2>
<div class="flex flex-wrap gap-4">
    {% if user.is_authenticated %}
        {# Zmieniono na użycie przestrzeni nazw 'accommodation_facilities:create_booking' #}
        <a href="{% url 'accommodation_facilities:create_booking' %}" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
            <i class="fas fa-calendar-alt mr-2"></i> Zarezerwuj pobyt
        </a>
        {# Pamiętaj, aby 'user_profile' i 'login' były zdefiniowane w Twoich urls.py #}
        <a href="{% url 'dashboard' %}" class="inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
            <i class="fas fa-user mr-2"></i> Mój profil
        </a>
    {% else %}
        <p class="text-gray-700">Zaloguj się, aby dokonać rezerwacji lub przeglądać swoje rezerwacje.</p>
        <a href="{% url 'login' %}" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
            <i class="fas fa-sign-in-alt mr-2"></i> Zaloguj się
        </a>
    {% endif %}
</div>
</div>

{% endblock %}