{% extends "base.html.jinja" %}

{% block title %}Moje Konto - {{ block.super }}{% endblock %}

{% block content %}
<div class="container mt-5 mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="title1">Witaj, {{ request.user.username }}!</h1>
        <a href="{% url 'logout' %}" class="btn btn-outline-danger">
            <i class="fas fa-sign-out-alt me-2"></i> Wyloguj się
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h3 class="h5 mb-0"><i class="bi bi-calendar-check me-2 text-success"></i>Nadchodzące i aktywne rezerwacje</h3>
                </div>
                <div class="card-body">
                    {% if upcoming_bookings %}
                        <div class="list-group list-group-flush">
                            {% for booking in upcoming_bookings %}
                            <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap">
                                <div>
                                    <h5 class="mb-1">Rezerwacja: {{ booking.start_date|date:"d.m.Y" }} - {{ booking.end_date|date:"d.m.Y" }}</h5>
                                    <p class="mb-1 text-muted">Goście: {{ booking.number_of_guests }}, Cena: <strong>{{ booking.total_price }} PLN</strong></p>
                                    <span class="badge 
                                        {% if booking.status == 'checked_in' %} bg-success
                                        {% elif booking.status == 'pending' %} bg-warning text-dark
                                        {% else %} bg-info text-dark {% endif %}">
                                        {{ booking.get_status_display }}
                                    </span>
                                </div>
                                <a href="{% url 'accommodation_facilities:booking_detail' booking.id %}" class="btn btn-sm btn-outline mt-2 mt-md-0">
                                    Szczegóły <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">Brak nadchodzących rezerwacji. Może czas coś zaplanować?</p>
                        <a href="{% url 'accommodation_facilities:offer' %}" class="btn btn-primary">Zobacz naszą ofertę</a>
                    {% endif %}
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="h5 mb-0"><i class="bi bi-clock-history me-2 text-muted"></i>Historia rezerwacji</h3>
                </div>
                <div class="card-body">
                    {% if past_bookings %}
                        <div class="list-group list-group-flush">
                            {% for booking in past_bookings %}
                                <div class="list-group-item">
                                    <p class="mb-1 text-muted">Rezerwacja: {{ booking.start_date|date:"d.m.Y" }} - {{ booking.end_date|date:"d.m.Y" }}</p>
                                    <span class="badge bg-secondary">{{ booking.get_status_display }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">Brak historycznych rezerwacji.</p>
                    {% endif %}
                </div>
            </div>

        </div>

        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <i class="bi bi-person-circle display-3 text-primary"></i>
                    <h4 class="card-title mt-3">{{ request.user.first_name }} {{ request.user.last_name }}</h4>
                    <p class="text-muted">{{ request.user.email }}</p>
                </div>
            </div>

            <div class="card shadow-sm mt-4">
                <div class="card-header bg-white">
                    <h3 class="h5 mb-0"><i class="bi bi-bar-chart-line me-2"></i>Twoje statystyki</h3>
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">Łączna liczba rezerwacji: <strong>{{ user_stats.total_bookings }}</strong></li>
                    <li class="list-group-item">Łączna liczba nocy: <strong>{{ user_stats.total_nights_stayed }}</strong></li>
                    <li class="list-group-item">Łącznie wydano: <strong>{{ user_stats.total_spent|floatformat:2 }} PLN</strong></li>
                </ul>
            </div>
            
            <div class="card shadow-sm mt-4 text-center">
                <div class="card-body">
                    <h5 class="card-title">Gotowy na kolejną przygodę?</h5>
                    <p class="card-text">Sprawdź dostępne terminy i zarezerwuj swój pobyt.</p>
                    <a href="{% url 'accommodation_facilities:create_booking' %}" class="btn btn-primary custom-button">Zarezerwuj teraz!</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}