{% extends "base.html.jinja" %}

{% block title %}Udogodnienia w pokojach{% endblock %}

{% block content %}
{% for room_type, amenities in grouped_amenities.items %}
  <h2>{{ room_type }}</h2>
  <ul>
    {% for amenity in amenities %}
      <li>
        {{ amenity.amenity }}
        {% if amenity.description %}
          – <em>{{ amenity.description }}</em>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endfor %}

{% if not grouped_amenities %}
  <p>Brak dostępnych udogodnień.</p>
{% endif %}
{% endblock %}
