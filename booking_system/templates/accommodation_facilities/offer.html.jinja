{% extends 'base.html.jinja' %}
{% block content %}
<section class="Offer" id="Offer">
    <div class="overlay"></div>
    <div class="container">
        <header class="text-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" height="40" width="40" viewBox="0 0 512 512"><path fill="#c68335" d="M256 448c141.4 0 256-93.1 256-208S397.4 32 256 32S0 125.1 0 240c0 45.1 17.7 86.8 47.7 120.9c-1.9 24.5-11.4 46.3-21.4 62.9c-5.5 9.2-11.1 16.6-15.2 21.6c-2.1 2.5-3.7 4.4-4.9 5.7c-.6 .6-1 1.1-1.3 1.4l-.3 .3c0 0 0 0 0 0c0 0 0 0 0 0s0 0 0 0s0 0 0 0c-4.6 4.6-5.9 11.4-3.4 17.4c2.5 6 8.3 9.9 14.8 9.9c28.7 0 57.6-8.9 81.6-19.3c22.9-10 42.4-21.9 54.3-30.6c31.8 11.5 67 17.9 104.1 17.9zm20-312l0 13.9c7.5 1.2 14.6 2.9 21.1 4.7c10.7 2.8 17 13.8 14.2 24.5s-13.8 17-24.5 14.2c-11-2.9-21.6-5-31.2-5.2c-7.9-.1-16 1.8-21.5 5c-4.8 2.8-6.2 5.6-6.2 9.3c0 1.8 .1 3.5 5.3 6.7c6.3 3.8 15.5 6.7 28.3 10.5l.7 .2c11.2 3.4 25.6 7.7 37.1 15c12.9 8.1 24.3 21.3 24.6 41.6c.3 20.9-10.5 36.1-24.8 45c-7.2 4.5-15.2 7.3-23.2 9l0 13.8c0 11-9 20-20 20s-20-9-20-20l0-14.6c-10.3-2.2-20-5.5-28.2-8.4c0 0 0 0 0 0s0 0 0 0s0 0 0 0c-2.1-.7-4.1-1.4-6.1-2.1c-10.5-3.5-16.1-14.8-12.6-25.3s14.8-16.1 25.3-12.6c2.5 .8 4.9 1.7 7.2 2.4c0 0 0 0 0 0c13.6 4.6 24 8.1 35.1 8.5c8.6 .3 16.5-1.6 21.4-4.7c4.1-2.5 6-5.5 5.9-10.5c0-2.9-.8-5-5.9-8.2c-6.3-4-15.4-6.9-28-10.7l-1.7-.5c-10.9-3.3-24.6-7.4-35.6-14c-12.7-7.7-24.6-20.5-24.7-40.7c-.1-21.1 11.8-35.7 25.8-43.9c6.9-4.1 14.5-6.8 22.2-8.5l0-14c0-11 9-20 20-20s20 9 20 20z"/></svg>
            <h5>Zarezerwuj swój wymarzony urlop</h5>
            <h1>Poznaj nasz cennik!</h1>
        </header>


            <div class="offer-slider" id="offerSlider">
                {% if main_accommodation and main_accommodation.seasonal_prices %}
                    {% for sp in main_accommodation.seasonal_prices %}
                        <div class="offer-item">
                            <div class="card testimonial-card">
                                <div class="card-body">
                                    <h4 class="my-0 fw-normal">{{ sp.season_name|default:"Nazwa sezonu" }}</h4>
                                    <h1 class="card-title pricing-card-title">{{ sp.price_per_night }} zł<small class="text-body-secondary fw-light">/doba</small></h1>
                                    <p class="card-text fst-italic">
                                        <li><strong>Okres:</strong></li>
                                        {# Sprawdzamy, czy mamy wiele dat (dla połączonego sezonu) #}
                                        {% if sp.dates %}
                                            {% for date_range in sp.dates %}
                                                <li>{{ date_range.start_date|date:"d.m.Y" }} – {{ date_range.end_date|date:"d.m.Y" }}</li>
                                            {% endfor %}
                                        {% else %}
                                            {# Standardowy przypadek z jedną datą #}
                                            <li>{{ sp.start_date|date:"d.m.Y" }} – {{ sp.end_date|date:"d.m.Y" }}</li>
                                        {% endif %}
                                        <p></p>
                                        <li>{{ sp.description|default:"Brak opisu dla sezonu." }}</li>
                                        <p></p>
                                    </p>
                                </div>
                                <div class="card-footer bg-transparent border-0 text-end">
                                    <small class="text-muted">
                                        {% if sp.included_services %}
                                            <strong>Cena zawiera:</strong> {{ sp.included_services|join:", " }}
                                        {% else %}
                                            <strong>Brak wliczonych usług w cenie sezonowej.</strong>
                                        {% endif %}
                                    </small>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p class="text-center">Brak dostępnych danych o cenniku dla obiektów lub brak zdefiniowanych cen sezonowych.</p>
                {% endif %}
            </div>
    </div>
    <div class="alert custom-alert text-center">
        <ul>
            <li>*Podane ceny obowiązują przy rezerwacjach do 6 osób. W celu zarezerwowania domku dla większej liczby osób prosimy o kontakt pod numerem tel. <a href="tel:+48509438974">+48 509 438 974</a></li>
            <li>Rezerwacji można dokonać telefonicznie, lub za pośrednictwem popularnych platform rezerwacyjnych takich jak <a href="https://www.booking.com/hotel/pl/janicka-chata.pl.html" target="_blank">Booking.com</a> lub <a href="https://www.nocowanie.pl/rezerwuj/1447927-janicka-chata-bialka-tatrzanska/" target="_blank">Nocowanie.pl</a></li>
        </ul>
    </div>
</section>
    <section class="additional-services">
        <div class="container my-5">
            <h2 class="text-center mb-4">Usługi Dodatkowe (niezależne od sezonu)</h2>
            {% if additional_services %}
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    {% for service in additional_services %}
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">{{ service.aditional_service }}</h5>
                                    <p class="card-text">{{ service.description|default:"Brak opisu." }}</p>
                                    <p class="card-text"><strong>Cena:</strong> {{ service.price }} PLN</p>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-center">Brak dostępnych usług dodatkowych.</p>
            {% endif %}
        </div>
    
    </section>
    <div class="container text-center my-5">
        <a href="{% url 'accommodation_facilities:create_booking' %}" class="btn btn-primary btn-lg rounded-pill px-4 py-2">
            Dokonaj rezerwacji
        </a>
{% endblock %}
