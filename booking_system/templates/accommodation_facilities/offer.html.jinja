{% extends 'base.html.jinja' %}

{% block content %}
<style>
    /* Custom styles for the card hover effect using Bootstrap variables */
    :root {
        --custom-primary-color: #c68335;
        --custom-primary-hover-color: #a96d26;
    }

    .offer-card-wrapper {
        overflow: hidden;
        position: relative;
        border-radius: var(--bs-card-border-radius);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 500px; /* Fixed height for uniform cards */
    }

    .offer-card-wrapper:hover,
    .offer-card-wrapper:focus {
        transform: translateY(-10px);
        box-shadow: var(--bs-box-shadow-lg);
    }
    
    /* Powiększ obrazek także na focus */
    .offer-card-wrapper:hover .card-img,
    .offer-card-wrapper:focus .card-img {
        transform: scale(1.05);
    }
    
    /* Ukryj początkowe info także na focus */
    .offer-card-wrapper:hover .card-initial-info,
    .offer-card-wrapper:focus .card-initial-info {
        opacity: 0;
    }
    
    /* Pokaż nakładkę także na focus */
    .offer-card-wrapper:hover .card-hover-overlay,
    .offer-card-wrapper:focus .card-hover-overlay {
        opacity: 1;
        z-index: 3;
    }

    .card-initial-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.5rem;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.85), transparent);
        color: white;
        transition: opacity 0.4s ease-in-out;
        z-index: 2;
        text-align: center;
    }

    .offer-card-wrapper:hover .card-initial-info {
        opacity: 0;
    }

    .card-hover-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(198, 131, 53, 0.95); /* Custom color with transparency */
        color: #ffffff; /* White text for contrast */
        padding: 1.5rem;
        opacity: 0;
        transition: opacity 0.4s ease-in-out;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: center; /* Center content vertically */
        align-items: center; /* Center content horizontally */
        text-align: center;
    }

    .offer-card-wrapper:hover .card-hover-overlay {
        opacity: 1;
        z-index: 3;
    }
    
    .custom-alert {
        background-color: var(--bs-light-bg-subtle);
        border-left: 5px solid var(--custom-primary-color);
    }
    .custom-alert a {
        color: var(--custom-primary-color);
        font-weight: 500;
        text-decoration: none;
    }
    .custom-alert a:hover {
        text-decoration: underline;
    }

    .btn-primary {
        background-color: var(--custom-primary-color);
        border-color: var(--custom-primary-color);
    }

    .btn-primary:hover {
        background-color: var(--custom-primary-hover-color);
        border-color: var(--custom-primary-hover-color);
    }
</style>

<section class="offer-section py-5" id="Offer">
    <div class="container">
        <!-- Header -->
        <header class="text-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" height="40" width="40" viewBox="0 0 512 512" class="mb-3">
                <path fill="#c68335" d="M256 448c141.4 0 256-93.1 256-208S397.4 32 256 32S0 125.1 0 240c0 45.1 17.7 86.8 47.7 120.9c-1.9 24.5-11.4 46.3-21.4 62.9c-5.5 9.2-11.1 16.6-15.2 21.6c-2.1 2.5-3.7 4.4-4.9 5.7c-.6 .6-1 1.1-1.3 1.4l-.3 .3c-4.6 4.6-5.9 11.4-3.4 17.4c2.5 6 8.3 9.9 14.8 9.9c28.7 0 57.6-8.9 81.6-19.3c22.9-10 42.4-21.9 54.3-30.6c31.8 11.5 67 17.9 104.1 17.9zm20-312l0 13.9c7.5 1.2 14.6 2.9 21.1 4.7c10.7 2.8 17 13.8 14.2 24.5s-13.8 17-24.5 14.2c-11-2.9-21.6-5-31.2-5.2c-7.9-.1-16 1.8-21.5 5c-4.8 2.8-6.2 5.6-6.2 9.3c0 1.8 .1 3.5 5.3 6.7c6.3 3.8 15.5 6.7 28.3 10.5l.7 .2c11.2 3.4 25.6 7.7 37.1 15c12.9 8.1 24.3 21.3 24.6 41.6c.3 20.9-10.5 36.1-24.8 45c-7.2 4.5-15.2 7.3-23.2 9l0 13.8c0 11-9 20-20 20s-20-9-20-20l0-14.6c-10.3-2.2-20-5.5-28.2-8.4c-2.1-.7-4.1-1.4-6.1-2.1c-10.5-3.5-16.1-14.8-12.6-25.3s14.8-16.1 25.3-12.6c2.5 .8 4.9 1.7 7.2 2.4c13.6 4.6 24 8.1 35.1 8.5c8.6 .3 16.5-1.6 21.4-4.7c4.1-2.5 6-5.5 5.9-10.5c0-2.9-.8-5-5.9-8.2c-6.3-4-15.4-6.9-28-10.7l-1.7-.5c-10.9-3.3-24.6-7.4-35.6-14c-12.7-7.7-24.6-20.5-24.7-40.7c-.1-21.1 11.8-35.7 25.8-43.9c6.9-4.1 14.5-6.8 22.2-8.5l0-14c0-11 9-20 20-20s20 9 20 20z"/></svg>
            <h5 class="text-uppercase text-secondary">Zarezerwuj swój wymarzony urlop</h5>
            <h1 class="display-4 fw-bold">Poznaj nasz cennik!</h1>
        </header>

        <!-- Grid with Offer Cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            
            {% if main_accommodation and main_accommodation.seasonal_prices %}
                {% for sp in main_accommodation.seasonal_prices %}
                <div class="col">
                    <div class="card offer-card-wrapper shadow-sm border-0" tabindex="0">
                        <img src="https://placehold.co/600x800/{% if loop.index is odd %}87CEEB/FFFFFF{% else %}D2B48C/FFFFFF{% endif %}?text={{ sp.season_name|urlencode }}" class="card-img" alt="Zdjęcie poglądowe dla sezonu {{ sp.season_name }}">
                        
                        <div class="card-initial-info">
                            <h3 class="card-title h4 fw-bold">{{ sp.season_name|default:"Nazwa sezonu" }}</h3>
                            <p class="h5 mt-1">{{ sp.price_per_night }} zł<small class="text-light fw-light">/doba</small></p>
                        </div>

                        <div class="card-hover-overlay">
                            <div class="d-flex flex-column justify-content-center flex-grow-1">
                                <h4 class="h5 fw-bold">{{ sp.season_name|default:"Nazwa sezonu" }}</h4>
                                <h1 class="card-title pricing-card-title">{{ sp.price_per_night }} zł<small class="text-body-secondary fw-light">/doba</small></h1>
                                <ul class="list-unstyled mt-3">
                                    {% if sp.dates %}
                                        {% for date_range in sp.dates %}
                                            <li><i class="bi bi-calendar-check me-2"></i>{{ date_range.start_date|date:"d.m.Y" }} – {{ date_range.end_date|date:"d.m.Y" }}</li>
                                        {% endfor %}
                                    {% else %}
                                        <li><i class="bi bi-calendar-check me-2"></i>{{ sp.start_date|date:"d.m.Y" }} – {{ sp.end_date|date:"d.m.Y" }}</li>
                                    {% endif %}
                                </ul>
                                <p class="mt-3 small">{{ sp.description|default:"Brak opisu dla tego sezonu."|truncatechars:120 }}</p>
                                <p> {% if sp.included_services %}
                                    <strong>Cena zawiera:</strong> {{ sp.included_services|join:", " }}
                                {% else %}
                                    <strong>Brak wliczonych usług w cenie sezonowej.</strong>
                                {% endif %}</p>
                            </div>
                            <a href="{% url 'accommodation_facilities:create_booking' %}" class="btn btn-light w-75 mt-4">Zarezerwuj teraz</a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <p class="text-center text-muted">Brak dostępnych danych o cenniku.</p>
                </div>
            {% endif %}

        </div>

        <!-- Additional Info Alert -->
        <div class="alert custom-alert text-center mt-5">
            <ul class="list-unstyled mb-0">
                <li class="mb-2">*Podane ceny obowiązują przy rezerwacjach do 6 osób. W celu zarezerwowania domku dla większej liczby osób prosimy o kontakt pod numerem tel. <a href="tel:+48509438974">+48 509 438 974</a></li>
                <li>Rezerwacji można dokonać telefonicznie, lub za pośrednictwem popularnych platform rezerwacyjnych.</li>
            </ul>
        </div>
    </div>
</section>

{% endblock %}
