{% extends 'base.html.jinja' %}
{% block content %}
<div class="bg-white p-8 rounded-lg shadow-xl w-full max-w-md text-center">
    <h1 class="text-3xl font-bold text-green-600 mb-4">{{ page_title }}</h1>
    <p class="text-gray-700 text-lg mb-6">Twoja rezerwacja została pomyślnie złożona!</p>

    {# Sprawdź, czy obiekt rezerwacji został przekazany #}
    {% if booking %}
        <div class="mt-6 text-left border-t border-gray-200 pt-6">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Szczegóły rezerwacji:</h2>
            <p class="text-gray-700 mb-2"><strong class="font-medium">Zakwaterowanie:</strong> {{ booking.accommodation.name }}</p>
            {# Pamiętaj, że address jest OneToOneField, więc dostęp do niego to booking.accommodation.address #}
            <p class="text-gray-700 mb-2"><strong class="font-medium">Adres:</strong> {{ booking.accommodation.address }}</p>
            <p class="text-gray-700 mb-2"><strong class="font-medium">Data przyjazdu:</strong> {{ booking.start_date|date:"d.m.Y" }}</p>
            <p class="text-gray-700 mb-2"><strong class="font-medium">Data wyjazdu:</strong> {{ booking.end_date|date:"d.m.Y" }}</p>
            <p class="text-gray-700 mb-2"><strong class="font-medium">Liczba dorosłych:</strong> {{ booking.number_of_adults }}</p>
            <p class="text-gray-700 mb-2"><strong class="font-medium">Liczba dzieci:</strong> {{ booking.number_of_children }}</p>
            <p class="text-gray-700 mb-2"><strong class="font-medium">Liczba gości (łącznie):</strong> {{ booking.number_of_guests }}</p>

            {# Wyświetl usługi dodatkowe, jeśli są #}
            {% if booking.additional_services.all %}
                <p class="text-gray-700 mb-2"><strong class="font-medium">Usługi dodatkowe:</strong></p>
                <ul class="list-disc list-inside ml-4 text-gray-700">
                    {% for service in booking.additional_services.all %}
                        <li>{{ service.aditional_service }} ({{ service.price|floatformat:2 }} PLN/doba)</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="text-gray-700 mb-2"><strong class="font-medium">Usługi dodatkowe:</strong> Brak</p>
            {% endif %}

            {# Wyświetl wyszczególnioną cenę #}
            <div class="mt-4 border-t border-gray-200 pt-4">
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Podsumowanie kosztów:</h3>
                <p class="text-gray-700 mb-1"><strong class="font-medium">Cena za zakwaterowanie:</strong> {{ booking.accommodation_subtotal_price|floatformat:2 }} PLN</p>
                <p class="text-gray-700 mb-1"><strong class="font-medium">Cena za usługi dodatkowe:</strong> {{ booking.additional_services_subtotal_price|floatformat:2 }} PLN</p>
                {% if booking.extra_guest_fee and booking.extra_guest_fee > 0 %}
                    <p class="text-gray-700 mb-1"><strong class="font-medium">Opłata za dodatkowych gości:</strong> {{ booking.extra_guest_fee|floatformat:2 }} PLN</p>
                {% endif %}
            </div>
            {# Wyświetl całkowitą cenę #}
            <p class="text-gray-800 text-2xl font-bold mt-4">Cena całkowita: {{ booking.total_price|floatformat:2 }} PLN</p>
        </div>
    {% else %}
        <p class="text-red-500">Nie udało się załadować szczegółów rezerwacji.</p>
    {% endif %}

    <div class="mt-8">
        <a href="{% url 'accommodation_facilities:create_booking' %}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Dokonaj kolejnej rezerwacji
        </a>
        <a href="/" class="ml-4 inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Wróć do strony głównej
        </a>
    </div>
</div>
{% endblock %}
