{% extends 'base.html.jinja' %}
{% block content %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg mt-5">
                <div class="card-body p-4 text-center">
                    <h1 class="card-title text-success mb-3">{{ page_title }}</h1>
                    <p class="card-text lead mb-4">Twoja rezerwacja została pomyślnie złożona!</p>

                    {% if booking %}
                        <div class="mt-4 text-start border-top pt-4">
                            <h2 class="h5 text-secondary mb-3 text-center">Szczegóły rezerwacji:</h2>
                            <p class="mb-1"><strong>Zakwaterowanie:</strong> {{ booking.accommodation.name }}</p>
                            <p class="mb-1"><strong>Adres:</strong> {{ booking.accommodation.address }}</p>
                            <p class="mb-1"><strong>Data przyjazdu:</strong> {{ booking.start_date|date:"d.m.Y" }}</p>
                            <p class="mb-1"><strong>Data wyjazdu:</strong> {{ booking.end_date|date:"d.m.Y" }}</p>
                            <p class="mb-1"><strong>Liczba dorosłych:</strong> {{ booking.number_of_adults }}</p>
                            <p class="mb-1"><strong>Liczba dzieci:</strong> {{ booking.number_of_children }}</p>
                            <p class="mb-1"><strong>Liczba gości (łącznie):</strong> {{ booking.number_of_guests }}</p>

                            {% with detailed_services=booking.get_detailed_services %}
                                {% if detailed_services %}
                                    <p class="mb-1 mt-3"><strong>Usługi dodatkowe:</strong></p>
                                    <ul class="list-unstyled ms-3">
                                        {% for service in detailed_services %}
                                            <li>
                                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                                {{ service.name }}
                                                <span class="text-muted small">{{ service.note }}</span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <p class="mb-1 mt-3"><strong>Usługi dodatkowe:</strong> Brak</p>
                                {% endif %}
                            {% endwith %}

                            <div class="mt-4 border-top pt-3">
                                <h3 class="h6 text-secondary mb-2">Podsumowanie kosztów:</h3>
                                <p class="mb-1"><strong>Cena za zakwaterowanie:</strong> {{ booking.accommodation_subtotal_price|floatformat:2 }} PLN</p>
                                <p class="mb-1"><strong>Cena za usługi dodatkowe:</strong> {{ booking.additional_services_subtotal_price|floatformat:2 }} PLN</p>
                                {% if booking.extra_guest_fee and booking.extra_guest_fee > 0 %}
                                    <p class="mb-1"><strong>Opłata za dodatkowych gości:</strong> {{ booking.extra_guest_fee|floatformat:2 }} PLN</p>
                                {% endif %}
                            </div>

                            <p class="h4 text-end mt-4"><strong>Cena całkowita:</strong> <span class="text-success">{{ booking.total_price|floatformat:2 }} PLN</span></p>
                        </div>
                    {% else %}
                        <div class="alert alert-danger mt-4" role="alert">
                            Nie udało się załadować szczegółów rezerwacji.
                        </div>
                    {% endif %}

                    <div class="mt-5 d-flex justify-content-center flex-wrap">
                        <a href="{% url 'accommodation_facilities:create_booking' %}" class="btn btn-primary btn-lg rounded-pill px-4 py-2 me-3 mb-2">
                            Dokonaj kolejnej rezerwacji
                        </a>
                        <a href="/" class="btn btn-outline-secondary btn-lg rounded-pill px-4 py-2 mb-2">
                            Wróć do strony głównej
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}