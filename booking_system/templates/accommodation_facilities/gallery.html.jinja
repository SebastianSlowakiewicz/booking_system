            <img src="{% static 'booking_system/images/gallery/36 (1).jpeg' %}" loading="lazy" alt="Domek 3" onclick="openModal(32)">
        </div>

        <div id="modal" class="modal">
            <span class="close" onclick="closeModal()">&times;</span>
            <span class="prev" onclick="changeImage(-1)">&#10094;</span>
            <img id="modalImage">
            <span class="next" onclick="changeImage(1)">&#10095;</span>
        </div>
    </div>
</main>

<script>
    // Tablica `images` jest teraz generowana przez Django
    const images = [
        "{% static 'booking_system/images/gallery/1.jpeg' %}",
        "{% static 'booking_system/images/gallery/2.jpeg' %}",
        "{% static 'booking_system/images/gallery/4.jpeg' %}",
        "{% static 'booking_system/images/gallery/5.jpeg' %}",
        "{% static 'booking_system/images/gallery/6.jpeg' %}",
        "{% static 'booking_system/images/gallery/7.jpeg' %}",
        "{% static 'booking_system/images/gallery/8.jpeg' %}",
        "{% static 'booking_system/images/gallery/9.jpeg' %}",
        "{% static 'booking_system/images/gallery/10.jpeg' %}",
        "{% static 'booking_system/images/gallery/12.jpeg' %}",
        "{% static 'booking_system/images/gallery/13.jpeg' %}",
        "{% static 'booking_system/images/gallery/14.jpg' %}",
        "{% static 'booking_system/images/gallery/15.jpg' %}",
        "{% static 'booking_system/images/gallery/16.jpg' %}",
        "{% static 'booking_system/images/gallery/17.jpg' %}",
        "{% static 'booking_system/images/gallery/18.jpg' %}",
        "{% static 'booking_system/images/gallery/19.jpg' %}",
        "{% static 'booking_system/images/gallery/20.jpg' %}",
        "{% static 'booking_system/images/gallery/21.jpg' %}",
        "{% static 'booking_system/images/gallery/22.jpg' %}",
        "{% static 'booking_system/images/gallery/23.jpg' %}",
        "{% static 'booking_system/images/gallery/24.jpg' %}",
        "{% static 'booking_system/images/gallery/25.jpg' %}",
        "{% static 'booking_system/images/gallery/26.jpeg' %}",
        "{% static 'booking_system/images/gallery/27.jpeg' %}",
        "{% static 'booking_system/images/gallery/28.jpeg' %}",
        "{% static 'booking_system/images/gallery/29.jpeg' %}",
        "{% static 'booking_system/images/gallery/30.jpeg' %}",
        "{% static 'booking_system/images/gallery/31.jpg' %}",
        "{% static 'booking_system/images/gallery/32.jpg' %}",
        "{% static 'booking_system/images/gallery/33.jpeg' %}",
        "{% static 'booking_system/images/gallery/35.jpeg' %}",
        "{% static 'booking_system/images/gallery/36.jpeg' %}",
    ];
    let currentIndex = 0;

    function openModal(index) {
        currentIndex = index;
        document.getElementById('modal').style.display = 'flex';
        document.getElementById('modalImage').src = images[currentIndex];
    }
    
    function closeModal() {
        document.getElementById('modal').style.display = 'none';
    }
    
    function changeImage(direction) {
        currentIndex += direction;
        if (currentIndex < 0) {
            currentIndex = images.length - 1;
        } else if (currentIndex >= images.length) {
            currentIndex = 0;
        }
        document.getElementById('modalImage').src = images[currentIndex];
    }
</script>
{% endblock %}