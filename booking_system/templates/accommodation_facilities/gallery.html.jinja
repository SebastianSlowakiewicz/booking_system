        <span class="next" onclick="changeImage(1)">&#10095;</span>
    </div>
    </div>  
</main>
<script>
    const images = [
        "./content/1.jpeg",
        "./content/2.jpeg",
        "./content/4.jpeg",
        "./content/5.jpeg",
        "./content/6.jpeg",
        "./content/7.jpeg",
        "./content/8.jpeg",
        "./content/9.jpeg",
        "./content/10.jpeg",
        "./content/12.jpeg",
        "./content/13.jpeg",
        "./content/14.jpg",
        "./content/15.jpg",
        "./content/16.jpg",
        "./content/17.jpg",
        "./content/18.jpg",
        "./content/19.jpg",
        "./content/20.jpg",
        "./content/21.jpg",
        "./content/22.jpg",
        "./content/23.jpg",
