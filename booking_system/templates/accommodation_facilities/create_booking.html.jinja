{% extends "base.html.jinja" %}
{% block title %}Zarezerwuj swój pobyt!{% endblock %}
{% block head_extra %}
{% endblock %}

{% block content %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg p-4">
                <div class="card-body">
                    <h1 class="card-title text-center mb-4">{{ page_title }}</h1>

                    {% if messages %}
                        <ul class="list-unstyled mb-4">
                            {% for message in messages %}
                                <li class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                                    {{ message }}
                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <form method="post" id="booking-form">
                        {% csrf_token %}

                        {% if form.errors %}
                            <div class="alert alert-danger" role="alert">
                                <strong>Proszę poprawić następujące błędy:</strong>
                                <ul class="list-unstyled mb-0">
                                    {% for field_name, errors in form.errors.items %}
                                        {% if field_name == '__all__' %}
                                            {% for error in errors %}
                                                <li>{{ error }}</li>
                                            {% endfor %}
                                        {% else %}
                                            <li><strong>{{ field_name }}:</strong>
                                                <ul class="list-unstyled ps-3">
                                                    {% for error in errors %}
                                                        <li>{{ error }}</li>
                                                    {% endfor %}
                                                </ul>
                                            </li>
                                        {% endif %}
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        {% for field in form %}
                            <div class="mb-3">
                                {% if field.field.widget.input_type == 'checkbox' or field.field.widget.input_type == 'radio' %}
                                    <label class="form-label">{{ field.label }}</label>
                                    <div id="additional-services-container">
                                        {% for choice in field %}
                                            <div class="form-check additional-service-item" data-service-id="{{ choice.data.value }}">
                                                {{ choice.tag }}
                                                <label class="form-check-label" for="{{ choice.id_for_label }}">
                                                    {{ choice.choice_label }}
                                                </label>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <label for="{{ field.id_for_label }}" class="form-label">{{ field.label }}</label>
                                    {{ field }}
                                {% endif %}

                                {% if field.help_text %}
                                    <div class="form-text text-muted">{{ field.help_text }}</div>
                                {% endif %}
                                {% if field.errors %}
                                    <ul class="errorlist">
                                        {% for error in field.errors %}
                                            <li>{{ error }}</li>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        {% endfor %}

                        <div class="text-center mt-4">
                            <h4 id="total-price-display">Cena całkowita: -- PLN</h4>
                            <div id="price-breakdown-display" class="text-start text-muted small mt-2"></div>
                            <div id="loading-indicator" class="d-none loading-spinner"></div>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Zarezerwuj
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('booking-form');
    const accommodationSelect = document.getElementById('id_accommodation');
    const startDateInput = document.getElementById('id_start_date');
    const endDateInput = document.getElementById('id_end_date');
    const adultsInput = document.getElementById('id_number_of_adults');
    const childrenInput = document.getElementById('id_number_of_children');
    const additionalServicesContainer = document.getElementById('additional-services-container');
    const additionalServicesCheckboxes = additionalServicesContainer.querySelectorAll('input[name="additional_services"]');
    const additionalServiceItems = additionalServicesContainer.querySelectorAll('.additional-service-item');
    const totalPriceDisplay = document.getElementById('total-price-display');
    const priceBreakdownDisplay = document.getElementById('price-breakdown-display');
    const loadingIndicator = document.getElementById('loading-indicator');

    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }
    const csrftoken = getCookie('csrftoken');

    let lastLockedServicesIds = [];
    let requestDebounceTimer;

    async function updatePrice() {
        const accommodationId = accommodationSelect.value;
        const startDate = startDateInput.value;
        const endDate = endDateInput.value;
        const numberOfAdults = adultsInput.value;
        const numberOfChildren = childrenInput.value;
        const userSelectedServicesForAjax = Array.from(additionalServicesCheckboxes)
            .filter(checkbox => checkbox.checked && !checkbox.disabled)
            .map(checkbox => checkbox.value);

        priceBreakdownDisplay.innerHTML = '';

        if (!accommodationId || !startDate || !endDate || numberOfAdults === '' || numberOfChildren === '') {
            totalPriceDisplay.textContent = 'Cena całkowita: -- PLN';
            additionalServiceItems.forEach(item => {
                item.classList.remove('disabled-checkbox-item');
                const checkbox = item.querySelector('input[type="checkbox"]');
                if (checkbox) {
                    checkbox.disabled = false;
                    checkbox.checked = false;
                }
            });
            lastLockedServicesIds = [];
            return;
        }

        loadingIndicator.classList.remove('d-none');
        try {
            const response = await fetch('{% url "accommodation_facilities:calculate_booking_price_ajax" %}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrftoken,
                },
                body: JSON.stringify({
                    accommodation_id: accommodationId,
                    start_date: startDate,
                    end_date: endDate,
                    number_of_adults: parseInt(numberOfAdults),
                    number_of_children: parseInt(numberOfChildren),
                    additional_services: userSelectedServicesForAjax,
                })
            });

            const data = await response.json();

            if (response.ok) {
                totalPriceDisplay.textContent = `Cena całkowita: ${data.total_price.toFixed(2)} PLN`;

                // NOWA, SZCZEGÓŁOWA LOGIKA TWORZENIA PODSUMOWANIA
                let breakdownHtml = `<ul class="list-unstyled mb-0">`;
                breakdownHtml += `<li>Zakwaterowanie: <strong>${data.accommodation_subtotal_price.toFixed(2)} PLN</strong></li>`;

                // Wyświetlanie usług wliczonych w cenę sezonu
                if (data.included_services_details && data.included_services_details.length > 0) {
                    breakdownHtml += `<li>Usługi w cenie sezonu:`;
                    breakdownHtml += `<ul class="list-unstyled ps-3">`;
                    data.included_services_details.forEach(service => {
                        breakdownHtml += `<li><small><i class="bi bi-check-circle-fill text-success me-1"></i>${service.name}</small></li>`;
                    });
                    breakdownHtml += `</ul></li>`;
                }

                // Wyświetlanie płatnych usług dodatkowych
                if (data.detailed_services_breakdown && data.detailed_services_breakdown.length > 0) {
                    breakdownHtml += `<li>Usługi dodatkowe:`;
                    breakdownHtml += `<ul class="list-unstyled ps-3">`;
                    data.detailed_services_breakdown.forEach(service => {
                        breakdownHtml += `<li><small>- ${service.name} ${service.note}: <strong>${service.total.toFixed(2)} PLN</strong></small></li>`;
                    });
                    breakdownHtml += `</ul></li>`;
                }
                
                if (data.extra_guest_fee > 0) {
                    breakdownHtml += `<li class="text-danger">Opłata za dodatkowych gości: <strong>${data.extra_guest_fee.toFixed(2)} PLN</strong></li>`;
                }
                breakdownHtml += `</ul>`;
                priceBreakdownDisplay.innerHTML = breakdownHtml;

                lastLockedServicesIds = data.locked_services_ids || [];

                additionalServiceItems.forEach(item => {
                    const checkbox = item.querySelector('input[type="checkbox"]');
                    const serviceId = parseInt(item.dataset.serviceId);

                    if (data.is_seasonal_services_locked && lastLockedServicesIds.includes(serviceId)) {
                        item.classList.add('disabled-checkbox-item');
                        if (checkbox) {
                            checkbox.disabled = true;
                            checkbox.checked = true;
                        }
                    } else {
                        item.classList.remove('disabled-checkbox-item');
                        if (checkbox) {
                            checkbox.disabled = false;
                        }
                    }
                });

            } else {
                totalPriceDisplay.textContent = 'Błąd obliczania ceny';
                priceBreakdownDisplay.innerHTML = `<p class="text-danger">${data.error || 'Wystąpił nieoczekiwany błąd.'}</p>`;
            }
        } catch (error) {
            console.error('Błąd podczas pobierania ceny:', error);
            totalPriceDisplay.textContent = 'Błąd połączenia';
            priceBreakdownDisplay.innerHTML = `<p class="text-danger">Nie można połączyć się z serwerem.</p>`;
        } finally {
            loadingIndicator.classList.add('d-none');
        }
    }
    
    function debounceUpdatePrice() {
        clearTimeout(requestDebounceTimer);
        requestDebounceTimer = setTimeout(updatePrice, 300);
    }

    [accommodationSelect, startDateInput, endDateInput, adultsInput, childrenInput].forEach(el => {
        el.addEventListener('change', debounceUpdatePrice);
    });
    adultsInput.addEventListener('input', debounceUpdatePrice);
    childrenInput.addEventListener('input', debounceUpdatePrice);
    additionalServicesCheckboxes.forEach(checkbox => {
        checkbox.addEventListener('change', debounceUpdatePrice);
    });

    form.addEventListener('submit', function(event) {
        additionalServiceItems.forEach(item => {
            const checkbox = item.querySelector('input[type="checkbox"]');
            if (checkbox && checkbox.disabled) {
                checkbox.disabled = false;
            }
        });
    });

    updatePrice();
});
</script>
{% endblock %}